{
  "name": "dmflow",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter @dmflow/shared build && pnpm --filter @dmflow/db build && pnpm --filter @dmflow/api build && pnpm --filter @dmflow/web build",
    "dev": "pnpm --parallel --filter @dmflow/api --filter @dmflow/web dev",
    "dev:api": "pnpm --filter @dmflow/api dev",
    "dev:worker": "pnpm --filter @dmflow/api dev:worker",
    "dev:web": "pnpm --filter @dmflow/web dev",
    "db:generate": "pnpm --filter @dmflow/db generate",
    "db:migrate": "pnpm --filter @dmflow/db migrate",
    "db:push": "pnpm --filter @dmflow/db push",
    "db:seed": "pnpm --filter @dmflow/db seed",
    "db:studio": "pnpm --filter @dmflow/db studio",
    "test": "pnpm --filter @dmflow/shared test && pnpm --filter @dmflow/api test && node scripts/check-i18n-parity.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "check:i18n": "node scripts/check-i18n-parity.mjs",
    "heroku-postbuild": "pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "playwright": "^1.62.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
